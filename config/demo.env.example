# Edit this file and copy it to config/demo.env, or pass equivalent flags to
# scripts/run_demo.py. Use addresses reserved for the demo on the same LAN as
# the Raspberry Pi. Do not overlap the DHCP pool or existing devices.
PARENT_INTERFACE=enp3s0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
CONTAINER_IP_RANGE=192.168.1.240/28
PI_IP=192.168.1.50
SERVICE_TYPE=_http._tcp
SCALE=10

# Copy to config/demo.env and edit the settings for your LAN. Command-line
# options to scripts/run_demo.py override these values.
SCENARIO=services
PARENT_INTERFACE=enp3s0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
CONTAINER_IP_RANGE=192.168.1.240/28
PI_IP=192.168.1.50
SERVICE_TYPE=_http._tcp
SCALE=10
TIMEOUT=90
CAPTURE=false
RESULTS_DIR=results
